//@version=6
indicator('Gap Classifier', overlay = true, max_boxes_count = 500)

// ═══════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════
enableGapFill   = input.bool(true,  'Enable Gap Fill Tracking', group = 'Gap Settings')
gapTimeframe    = input.timeframe('', 'Gap Timeframe',            group = 'Gap Settings')
maxGapsToTrack  = input.int(10, 'Max Gaps to Track', minval = 1, maxval = 200, group = 'Gap Settings')
gapMaxAge       = input.int(365, 'Max Gap Age (bars)', minval = 50, maxval = 1000, group = 'Gap Settings')
gapUpUnfilled   = input.color(color.new(color.green, 75), 'Gap Up (Unfilled)',   group = 'Gap Colors')
gapDownUnfilled = input.color(color.new(color.red, 75),   'Gap Down (Unfilled)', group = 'Gap Colors')

gapClassEnabled = input.bool(true,   'Enable Gap Classification',       group = 'Gap Classification')
adxLen          = input.int(14,      'ADX Length (trend filter)', minval = 1, group = 'Gap Classification')
gapVolLen       = input.int(20,      'Volume MA Length',  minval = 5,   group = 'Gap Classification')
gapKBreak       = input.float(2.0,   'Breakaway Vol Ratio', minval = 1.0, step = 0.1, group = 'Gap Classification')
gapKRun         = input.float(1.5,   'Runaway Vol Ratio',   minval = 1.0, step = 0.1, group = 'Gap Classification')
gapAdxThr       = input.float(25,    'ADX Trending Threshold', minval = 10,           group = 'Gap Classification')
gapRangeLB      = input.int(20,      'Range Lookback',    minval = 5,   group = 'Gap Classification')
gapMatureBars   = input.int(30,      'Trend Maturity (bars)', minval = 10,            group = 'Gap Classification')
gapBrkColor     = input.color(color.new(#2196F3, 75), 'Breakaway Fill',  group = 'Gap Classification')
gapRunColor     = input.color(color.new(#4CAF50, 75), 'Runaway Fill',    group = 'Gap Classification')
gapExhColor     = input.color(color.new(#FF9800, 75), 'Exhaustion Fill', group = 'Gap Classification')
gapComColor     = input.color(color.new(#9E9E9E, 75), 'Common Fill',    group = 'Gap Classification')

// ═══════════════════════════════════════════════════════════════════════
// UDT
// ═══════════════════════════════════════════════════════════════════════
type GapInfo
    bool  isUp
    float top
    float bottom
    float originalTop
    float originalBottom
    int   startBar
    box   gapBox
    float fillPercent
    bool  isFilled
    int   gapClass

// ═══════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════
calculateFillPercent(gap) =>
    originalGapSize = gap.originalTop - gap.originalBottom
    if originalGapSize <= 0
        0.0
    else if gap.isUp
        low >= gap.originalTop    ? 0.0   :
         low <= gap.originalBottom ? 100.0 :
         math.min((gap.originalTop - low) / originalGapSize * 100, 100.0)
    else
        high <= gap.originalBottom ? 0.0   :
         high >= gap.originalTop   ? 100.0 :
         math.min((high - gap.originalBottom) / originalGapSize * 100, 100.0)

f_classifyGap(_isUp, _gapVolR_, _breaksRange, _inTrend, _extended) =>
    int result = 4
    if _gapVolR_ >= gapKBreak and _breaksRange and not _extended
        result := 1      // Breakaway
    else if _gapVolR_ >= gapKBreak and _extended
        result := 3      // Exhaustion
    else if _gapVolR_ >= gapKRun and _inTrend and not _extended
        result := 2      // Runaway
    result

f_gapClassBg(gc, _isUp) =>
    switch gc
        1 => gapBrkColor
        2 => gapRunColor
        3 => gapExhColor
        => gapComColor

// ═══════════════════════════════════════════════════════════════════════
// GLOBAL-SCOPE CALCS
// These must live at global scope — Pine forbids ta.* / request.* inside if blocks.
// ═══════════════════════════════════════════════════════════════════════
[_, _, adx] = ta.dmi(adxLen, adxLen)
adx_safe    = nz(adx, 0.0)

_gapAvgVol  = ta.sma(volume, gapVolLen)
_gapVolR    = nz(volume / _gapAvgVol, 1.0)
_gapRngHi   = ta.highest(high, gapRangeLB)[1]
_gapRngLo   = ta.lowest(low,   gapRangeLB)[1]

// Trend duration counter
var int _gapTrendDur = 0
_gapTrendDur := adx_safe > gapAdxThr ? _gapTrendDur + 1 : 0

// ═══════════════════════════════════════════════════════════════════════
// GAP FILL TRACKING  (with volume-based classification)
// ═══════════════════════════════════════════════════════════════════════
float prevTFClose = request.security(syminfo.tickerid, gapTimeframe, close[1],
     lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

bool isFirstBarOfNewSession =
     request.security(syminfo.tickerid, gapTimeframe, time,
          lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true) !=
     request.security(syminfo.tickerid, gapTimeframe, time[1],
          lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

var array<GapInfo> activeGaps = array.new<GapInfo>()

_gapTFSec   = gapTimeframe == '' ? timeframe.in_seconds(timeframe.period) : timeframe.in_seconds(gapTimeframe)
_chartTFSec = timeframe.in_seconds(timeframe.period)
_gapTFMatch = _gapTFSec == _chartTFSec

if not _gapTFMatch and array.size(activeGaps) > 0
    for i = 0 to array.size(activeGaps) - 1
        gap = array.get(activeGaps, i)
        if not na(gap.gapBox)
            box.set_bgcolor(gap.gapBox, color.new(color.black, 100))
            box.set_border_color(gap.gapBox, color.new(color.black, 100))

if enableGapFill and _gapTFMatch and isFirstBarOfNewSession and not na(prevTFClose)
    if low > prevTFClose
        _breaksRange = close > _gapRngHi
        _inTrend     = adx_safe > gapAdxThr
        _extended    = _gapTrendDur > gapMatureBars
        gc = gapClassEnabled ?
             f_classifyGap(true, _gapVolR, _breaksRange, _inTrend, _extended) : 0

        newBox = box.new(bar_index[1], low, bar_index + 50, prevTFClose,
               border_width = 0,
               bgcolor      = gapClassEnabled ? f_gapClassBg(gc, true) : gapUpUnfilled)

        array.push(activeGaps,
             GapInfo.new(true, low, prevTFClose, low, prevTFClose,
                  bar_index, newBox, 0.0, false, gc))

        if array.size(activeGaps) > maxGapsToTrack
            oldGap = array.shift(activeGaps)
            if not na(oldGap.gapBox)
                box.delete(oldGap.gapBox)

    if high < prevTFClose
        _breaksRange = close < _gapRngLo
        _inTrend     = adx_safe > gapAdxThr
        _extended    = _gapTrendDur > gapMatureBars
        gc = gapClassEnabled ?
             f_classifyGap(false, _gapVolR, _breaksRange, _inTrend, _extended) : 0

        newBox = box.new(bar_index[1], prevTFClose, bar_index + 50, high,
          border_width = 0,
          bgcolor      = gapClassEnabled ? f_gapClassBg(gc, false) : gapDownUnfilled)

        array.push(activeGaps,
             GapInfo.new(false, prevTFClose, high, prevTFClose, high,
                  bar_index, newBox, 0.0, false, gc))

        if array.size(activeGaps) > maxGapsToTrack
            oldGap = array.shift(activeGaps)
            if not na(oldGap.gapBox)
                box.delete(oldGap.gapBox)

if enableGapFill and _gapTFMatch and array.size(activeGaps) > 0
    for i = array.size(activeGaps) - 1 to 0 by 1
        gap = array.get(activeGaps, i)
        if not na(gap)
            _age = bar_index - gap.startBar
            gap.fillPercent := calculateFillPercent(gap)
            if gap.fillPercent >= 50 or _age > gapMaxAge
                if not na(gap.gapBox)
                    box.delete(gap.gapBox)
                array.remove(activeGaps, i)
            else
                if barstate.islast
                    box.set_right(gap.gapBox, bar_index)
