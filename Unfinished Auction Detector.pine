//@version=6
indicator('Unfinished Auction Detector', overlay = true, max_lines_count = 200, max_labels_count = 200)

// ═══════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════
volAvgLen      = input.int(20,   'Volume Average Length', minval = 5, maxval = 50, group = 'General')

unfVolThresh   = input.float(1.2,  'Min Volume to Flag (x avg)',  minval = 1.0, step = 0.1,   group = 'Unfinished Auction')
unfWickPct     = input.float(0.4,  'Min Wick Ratio (wick/range)', minval = 0.1, maxval = 0.9,
     step = 0.05,                                                                group = 'Unfinished Auction')
unfAtrMult     = input.float(0.1,  'Touch Sensitivity (ATR mult)',
     minval = 0.01, maxval = 1.0, step = 0.01,
     tooltip = 'Price is considered "returned" when it comes within this multiple of ATR(14) of the level. Adapts automatically to instrument volatility.',
                                                                                 group = 'Unfinished Auction')
unfMaxLevels   = input.int(5,      'Max Levels to Track',         minval = 1, maxval = 20,    group = 'Unfinished Auction')
unfExtendBars  = input.int(5,    'Extend Level (bars)',         minval = 1, maxval = 500,   group = 'Unfinished Auction')
unfBullColor   = input.color(color.new(color.teal,   50), 'Bull Unfinished Color', group = 'Unfinished Auction')
unfBearColor   = input.color(color.new(color.orange, 50), 'Bear Unfinished Color', group = 'Unfinished Auction')
unfLabelSize   = input.string('tiny', 'Label Size',
     options = ['tiny', 'small', 'normal', 'large'], group = 'Unfinished Auction')
unfTouchRemove = input.bool(true, 'Remove When Price Returns', group = 'Unfinished Auction')

// ═══════════════════════════════════════════════════════════════════════
// UDT
// ═══════════════════════════════════════════════════════════════════════
type UnfinishedLevel
    float price
    bool  isBull
    int   startBar
    line  lvlLine
    label lvlLabel
    bool  touched

// ═══════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════
f_getSize(s) =>
    switch s
        'tiny'   => size.tiny
        'small'  => size.small
        'normal' => size.normal
        'large'  => size.large
        =>          size.tiny

// ═══════════════════════════════════════════════════════════════════════
// CORE
// ═══════════════════════════════════════════════════════════════════════
barRange  = high - low
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
isBullBar = close >= open

avgVol = ta.sma(volume, volAvgLen)
atrVal = ta.atr(14)

// ═══════════════════════════════════════════════════════════════════════
// UNFINISHED AUCTION — high-volume bar rejected at one extreme, wick left behind
// ═══════════════════════════════════════════════════════════════════════
var array<UnfinishedLevel> unfLevels = array.new<UnfinishedLevel>()

isHighVolBar  = volume > avgVol * unfVolThresh
unfWickRatio  = barRange > 0 ? lowerWick / barRange : 0.0
unfUpperRatio = barRange > 0 ? upperWick / barRange : 0.0

isBullUnfinished = isHighVolBar and unfWickRatio  >= unfWickPct and isBullBar
isBearUnfinished = isHighVolBar and unfUpperRatio >= unfWickPct and not isBullBar

unfLblSz = f_getSize(unfLabelSize)

if isBullUnfinished
    targetPrice = low
    lvlLine  = line.new(bar_index, targetPrice, bar_index + unfExtendBars, targetPrice,
         color = unfBullColor, width = 1, style = line.style_dotted)
    lvlLabel = label.new(bar_index + unfExtendBars, targetPrice, 'UA↑',
         color     = color.new(unfBullColor, 50),
         textcolor = color.white,
         style     = label.style_label_left,
         size      = unfLblSz,
         tooltip   = 'Unfinished Bull Auction: Price rejected this low with high volume. Likely return target.')
    array.push(unfLevels, UnfinishedLevel.new(targetPrice, true, bar_index, lvlLine, lvlLabel, false))
    if array.size(unfLevels) > unfMaxLevels
        oldU = array.shift(unfLevels)
        if not na(oldU.lvlLine)
            line.delete(oldU.lvlLine)
        if not na(oldU.lvlLabel)
            label.delete(oldU.lvlLabel)

if isBearUnfinished
    targetPrice = high
    lvlLine  = line.new(bar_index, targetPrice, bar_index + unfExtendBars, targetPrice,
         color = unfBearColor, width = 1, style = line.style_dotted)
    lvlLabel = label.new(bar_index + unfExtendBars, targetPrice, 'UA↓',
         color     = color.new(unfBearColor, 50),
         textcolor = color.white,
         style     = label.style_label_left,
         size      = unfLblSz,
         tooltip   = 'Unfinished Bear Auction: Price rejected this high with high volume. Likely return target.')
    array.push(unfLevels, UnfinishedLevel.new(targetPrice, false, bar_index, lvlLine, lvlLabel, false))
    if array.size(unfLevels) > unfMaxLevels
        oldU = array.shift(unfLevels)
        if not na(oldU.lvlLine)
            line.delete(oldU.lvlLine)
        if not na(oldU.lvlLabel)
            label.delete(oldU.lvlLabel)

if array.size(unfLevels) > 0
    for i = array.size(unfLevels) - 1 to 0 by 1
        u = array.get(unfLevels, i)
        if not na(u) and not u.touched
            if barstate.islast
                line.set_x2(u.lvlLine, bar_index + unfExtendBars)
                label.set_x(u.lvlLabel, bar_index + unfExtendBars)
            if unfTouchRemove and bar_index > u.startBar
                touchDist     = atrVal * unfAtrMult
                priceReturned = u.isBull
                     ? low  <= u.price + touchDist
                     : high >= u.price - touchDist
                if priceReturned
                    u.touched := true
                    line.delete(u.lvlLine)
                    label.delete(u.lvlLabel)
                    array.remove(unfLevels, i)
