//@version=6
indicator('TD Sequential', overlay = true, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════
tdPaintBars   = input.bool(false, 'Paint Bars',                                     group = 'TD Sequential')
tdShowLabels  = input.bool(true,  'Show Labels',                                     group = 'TD Sequential')
tdShow7       = input.bool(false, 'Show Label at Count 7',                           group = 'TD Sequential')
tdShow9       = input.bool(false, 'Show Label at Count 9',                           group = 'TD Sequential')
tdShow13      = input.bool(true,  'Show Label at Count 13',                          group = 'TD Sequential')
tdLabelSize   = input.string('tiny', 'Label Size',
     options = ['auto', 'tiny', 'small', 'normal', 'large', 'huge'], group = 'TD Sequential')
tdLabelOffset = input.int(0, 'Label Vertical Offset (ATR multiples)',
     minval = -20, maxval = 20, group = 'TD Sequential')
atrLen        = input.int(14, 'ATR Length (for label offset)', minval = 1, group = 'TD Sequential')

tdBuyBarStart  = input.color(color.rgb(17, 231, 242), 'Buy Bar Start Color',  group = 'TD Sequential Colors')
tdBuyBarEnd    = input.color(color.rgb(2, 38, 158),   'Buy Bar End Color',    group = 'TD Sequential Colors')
tdSellBarStart = input.color(color.rgb(238, 242, 17), 'Sell Bar Start Color', group = 'TD Sequential Colors')
tdSellBarEnd   = input.color(color.rgb(207, 0, 0),    'Sell Bar End Color',   group = 'TD Sequential Colors')
tdBuyLbl7Bg    = input.color(color.new(color.blue, 40),  'Buy Label 7 Bg',    group = 'TD Sequential Colors')
tdBuyLbl9Bg    = input.color(color.new(color.blue, 10),  'Buy Label 9 Bg',    group = 'TD Sequential Colors')
tdBuyLbl13Bg   = input.color(color.rgb(2, 38, 158),      'Buy Label 13 Bg',   group = 'TD Sequential Colors')
tdBuyLblText   = input.color(color.white,                 'Buy Label Text',   group = 'TD Sequential Colors')
tdSellLbl7Bg   = input.color(color.new(color.orange, 40), 'Sell Label 7 Bg',  group = 'TD Sequential Colors')
tdSellLbl9Bg   = input.color(color.new(color.red, 10),    'Sell Label 9 Bg',  group = 'TD Sequential Colors')
tdSellLbl13Bg  = input.color(color.rgb(207, 0, 0),        'Sell Label 13 Bg', group = 'TD Sequential Colors')
tdSellLblText  = input.color(color.white,                  'Sell Label Text',  group = 'TD Sequential Colors')

// ═══════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════
f_getSize(s) =>
    switch s
        'tiny'   => size.tiny
        'small'  => size.small
        'normal' => size.normal
        'large'  => size.large
        'huge'   => size.huge
        =>          size.auto

f_tdColorLerp(c1, c2, cnt) =>
    clamped = math.max(1, math.min(13, cnt))
    t = (clamped - 1) / 12.0
    r = math.round(color.r(c1) + (color.r(c2) - color.r(c1)) * t)
    g = math.round(color.g(c1) + (color.g(c2) - color.g(c1)) * t)
    b = math.round(color.b(c1) + (color.b(c2) - color.b(c1)) * t)
    color.rgb(r, g, b)

atr = nz(ta.atr(atrLen), 1.0)

// ═══════════════════════════════════════════════════════════════════════
// TD SEQUENTIAL — Tom DeMark buy/sell setup counter
// ═══════════════════════════════════════════════════════════════════════
buySetup  = 0
buySetup  := close < close[4] ? buySetup[1] == 13 ? 1 : buySetup[1] + 1 : 0
sellSetup = 0
sellSetup := close > close[4] ? sellSetup[1] == 13 ? 1 : sellSetup[1] + 1 : 0

tdBuyColor  = buySetup  >= 1 ? f_tdColorLerp(tdBuyBarStart,  tdBuyBarEnd,  buySetup)  : na
tdSellColor = sellSetup >= 1 ? f_tdColorLerp(tdSellBarStart, tdSellBarEnd, sellSetup) : na
tdBarColor  = buySetup  >= 1 ? tdBuyColor : sellSetup >= 1 ? tdSellColor : na

barcolor(tdPaintBars ? tdBarColor : na)

if tdShowLabels
    tdLblSz  = f_getSize(tdLabelSize)
    tdOffset = atr * tdLabelOffset
    if buySetup == 7 and tdShow7
        label.new(bar_index, low - tdOffset, '7',
             color = tdBuyLbl7Bg, textcolor = tdBuyLblText,
             style = label.style_label_up, size = tdLblSz)
    if buySetup == 9 and tdShow9
        label.new(bar_index, low - tdOffset, '9',
             color = tdBuyLbl9Bg, textcolor = tdBuyLblText,
             style = label.style_label_up, size = tdLblSz)
    if buySetup == 13 and tdShow13
        label.new(bar_index, low - tdOffset, '13',
             color = tdBuyLbl13Bg, textcolor = tdBuyLblText,
             style = label.style_label_up, size = tdLblSz)
    if sellSetup == 7 and tdShow7
        label.new(bar_index, high + tdOffset, '7',
             color = tdSellLbl7Bg, textcolor = tdSellLblText,
             style = label.style_label_down, size = tdLblSz)
    if sellSetup == 9 and tdShow9
        label.new(bar_index, high + tdOffset, '9',
             color = tdSellLbl9Bg, textcolor = tdSellLblText,
             style = label.style_label_down, size = tdLblSz)
    if sellSetup == 13 and tdShow13
        label.new(bar_index, high + tdOffset, '13',
             color = tdSellLbl13Bg, textcolor = tdSellLblText,
             style = label.style_label_down, size = tdLblSz)

// ═══════════════════════════════════════════════════════════════════════
// HIDDEN PLOTS (for strategy use / alerts)
// ═══════════════════════════════════════════════════════════════════════
plot(buySetup,  title = 'TD Buy Setup',  display = display.none)
plot(sellSetup, title = 'TD Sell Setup', display = display.none)
